# Only files copied by the Dockerfile belong in the build context.
**
!pyproject.toml
!uv.lock
!alembic.ini
!LICENSE
!app/
!app/**
!migrations/
!migrations/**
!scripts/
!scripts/**
!data/
data/**
!data/.gitkeep

# Exclude local artifacts even inside the source directories above.
**/.env
**/.env.*
**/.envrc
**/*.pem
**/*.key
**/__pycache__
**/*.py[cod]
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.log
**/*.log.*
**/logs
**/backup
**/backups
**/*.bak
**/*.bak.*
**/*.backup
**/*.backup.*
**/*.dump
**/*.sql.gz
