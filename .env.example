# Fill in your own bot token and administrator IDs in .env.
BOT_TOKEN=
ADMIN_IDS=
WHITELIST_IDS=
STUDIO_CHAT_ID=
ADMIN_CONTACT=

# Demonstration settings for a new database.
STUDIO_NAME="Example Rehearsal Studio"
TIMEZONE=UTC
RULES="Подготовка и уборка входят в забронированное время."

DATABASE_URL=sqlite+aiosqlite:///data/flat.db

MAX_BOOKING_DAYS=14
MIN_BOOKING_MINUTES=60
MAX_BOOKING_MINUTES=1440
BOOKING_STEP_MINUTES=30
OPEN_MINUTE=0
CLOSE_MINUTE=1440

REMINDER_24H_ENABLED=true
REMINDER_1H_ENABLED=true
GROUP_NOTIFICATIONS_ENABLED=false

LOG_LEVEL=INFO
SQL_ECHO=false
NOTIFICATION_POLL_INTERVAL_SECONDS=30
BOOKING_STATUS_CHECK_INTERVAL_SECONDS=60
